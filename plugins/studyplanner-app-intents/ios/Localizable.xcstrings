    "Save an assignment for StudyPlanner to review when you open the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save an assignment for StudyPlanner to review when you open the app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ واجبًا لمراجعته عند فتح StudyPlanner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere eine Aufgabe, die du beim Öffnen von StudyPlanner prüfst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una tarea para revisarla cuando abras StudyPlanner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre un devoir à vérifier à l’ouverture de StudyPlanner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक असाइनमेंट सहेजें, जिसे StudyPlanner खोलने पर आप जाँचेंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "課題を保存し、StudyPlannerを開いたときに確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "과제를 저장해 두고 StudyPlanner를 열 때 확인해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve uma tarefa para revisar quando abrir o StudyPlanner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存一项作业，打开 StudyPlanner 时再确认。"
          }
        }
      }
    },
