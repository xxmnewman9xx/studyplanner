    "What's the assignment? Include the class and due date.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's the assignment? Include the class and due date."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الواجب؟ اذكر المادة وموعد التسليم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Aufgabe? Nenne auch Kurs und Abgabedatum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuál es la tarea? Incluye la materia y la fecha de entrega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel est le devoir ? Précise le cours et la date de remise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कौन सा असाइनमेंट है? विषय और जमा करने की तारीख भी बताएँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんな課題ですか？授業名と締め切り日も教えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 과제인가요? 수업과 마감일도 말해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual é a tarefa? Inclua a disciplina e a data de entrega."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是什么作业？请说出课程和截止日期。"
          }
        }
      }
    },
