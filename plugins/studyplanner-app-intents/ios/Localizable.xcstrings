    "Hear the next study step from today's plan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hear the next study step from today's plan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمع إلى خطوة المذاكرة التالية من خطة اليوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör dir den nächsten Lernschritt aus deinem heutigen Plan an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha el siguiente paso de estudio del plan de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute la prochaine étape de révision du plan du jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की योजना से पढ़ाई का अगला कदम सुनें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のプランから次の学習ステップを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 계획에서 다음 공부 단계를 알려 드려요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouça o próximo passo de estudo do plano de hoje."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听取今天计划中的下一步学习安排。"
          }
        }
      }
    },
    "Hear your next three deadlines.": {
      "extractionState": "manual",
      "localizations": {
