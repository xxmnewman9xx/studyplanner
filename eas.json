{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "simulator-qa": {
      "distribution": "internal",
      "environment": "production",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_STUDYPLANNER_CAPTURE_QA": "1"
      },
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": false,
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6766181202"
      }
    }
  }
}
