{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "outDir": "dist",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false
  },
  "include": [
    "server/syllabus-parser/**/*.ts",
    "src/services/pdfText.ts",
    "src/services/syllabusLocalParser.ts",
    "src/models.ts"
  ],
  "exclude": [
    "node_modules",
    ".expo",
    "dist"
  ]
}
