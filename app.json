{
  "expo": {
    "name": "StudyPlanner: Syllabus AI",
    "slug": "study-planner-syllabus-ai",
    "version": "1.0.2",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/app/study-planner-icon.png",
    "scheme": "studyplanner",
    "splash": {
      "image": "./assets/app/study-planner-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F8FC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mattnewman.studyplanner",
      "icon": "./assets/app/study-planner-icon.png",
      "buildNumber": "28",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.mattnewman.studyplanner"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Use the camera only when image import is enabled to attach syllabus pages for manual review.",
        "NSPhotoLibraryUsageDescription": "Use the photo library only when image import is enabled to attach syllabus images for manual review.",
        "NSCalendarsFullAccessUsageDescription": "Sync assignment and exam dates to your calendar.",
        "NSUserNotificationsUsageDescription": "Send calm reminders before deadlines, exams, and classes."
      }
    },
    "android": {
      "package": "com.studyplanner.syllabusai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app/study-planner-icon.png",
        "backgroundColor": "#F6F8FC"
      },
      "permissions": [
        "CAMERA",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-calendar",
      "expo-document-picker",
      "expo-image-picker",
      "expo-notifications",
      "expo-iap",
      "expo-font",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.mattnewman.studyplanner.widgets",
          "groupIdentifier": "group.com.mattnewman.studyplanner",
          "widgets": [
            {
              "name": "StudyPlannerTodayWidget",
              "displayName": "StudyPlanner Today",
              "description": "Shows reviewed work due today from StudyPlanner.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "contentMarginsDisabled": true
            },
            {
              "name": "StudyPlannerUpcomingWidget",
              "displayName": "StudyPlanner Upcoming",
              "description": "Shows upcoming reviewed deadlines from StudyPlanner.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "contentMarginsDisabled": true
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "69335c75-753e-424e-8a76-c8bd2455a112",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.mattnewman.studyplanner.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.mattnewman.studyplanner"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "xxmnewman9xx"
  }
}
