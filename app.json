{
  "expo": {
    "name": "Studyplanner: Syllabus AI",
    "slug": "study-planner-syllabus-ai",
    "scheme": "studyplanner",
    "version": "2.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F5F5F7",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "5JN35MJ3QD",
      "bundleIdentifier": "com.mattnewman.studyplanner",
      "buildNumber": "81",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.mattnewman.studyplanner"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1", "1C8F.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Use the camera to read syllabus photos with OCR and turn assignments, exams, and deadlines into reviewed planner items.",
        "NSPhotoLibraryUsageDescription": "Use selected syllabus photos for OCR so assignments, exams, and deadlines can be reviewed before they are added.",
        "NSUserNotificationsUsageDescription": "Send calm reminders before deadlines, exams, and classes."
      }
    },
    "android": {
      "versionCode": 79,
      "package": "com.mattnewman.studyplanner",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#050507",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ],
      "expo-iap",
      "expo-notifications",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Use the camera to guide syllabus and notes scans with framing feedback before OCR review.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "./plugins/with-widgetkit-kinds",
      "./plugins/with-widget-privacy-manifest",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.mattnewman.studyplanner.widgets",
          "groupIdentifier": "group.com.mattnewman.studyplanner",
          "widgets": [
            {
              "name": "StudyPlannerTodayWidget",
              "kind": "studyplanner.today",
              "displayName": "StudyPlanner Today",
              "description": "See what needs your attention today.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryInline",
                  "accessoryCircular",
                  "accessoryRectangular"
                ],
                "configuration": {
                  "title": "StudyPlanner Today",
                  "description": "Choose the Today widget view.",
                  "parameters": {
                    "viewMode": {
                      "title": "View",
                      "type": "enum",
                      "default": "today",
                      "values": [
                        { "name": "Today", "value": "today" }
                      ]
                    }
                  }
                },
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "StudyPlannerUpcomingWidget",
              "kind": "studyplanner.upcoming",
              "displayName": "StudyPlanner Upcoming",
              "description": "Preview upcoming assignments and deadlines.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryInline",
                  "accessoryCircular",
                  "accessoryRectangular"
                ],
                "configuration": {
                  "title": "StudyPlanner Upcoming",
                  "description": "Choose the Upcoming widget view.",
                  "parameters": {
                    "viewMode": {
                      "title": "View",
                      "type": "enum",
                      "default": "upcoming",
                      "values": [
                        { "name": "Upcoming", "value": "upcoming" }
                      ]
                    }
                  }
                },
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "StudyPlannerWeekWidget",
              "kind": "studyplanner.week",
              "displayName": "StudyPlanner Week",
              "description": "Check your weekly workload at a glance.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "accessoryInline",
                  "accessoryCircular",
                  "accessoryRectangular"
                ],
                "configuration": {
                  "title": "StudyPlanner Week",
                  "description": "Use the calendar widget view.",
                  "parameters": {
                    "viewMode": {
                      "title": "View",
                      "type": "enum",
                      "default": "week",
                      "values": [
                        { "name": "Week", "value": "week" }
                      ]
                    }
                  }
                },
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "StudyPlannerClassProgressWidget",
              "kind": "studyplanner.classProgress",
              "displayName": "StudyPlanner Class Progress",
              "description": "Track progress for a selected class.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryInline",
                  "accessoryCircular",
                  "accessoryRectangular"
                ],
                "configuration": {
                  "title": "StudyPlanner Class",
                  "description": "Use the class progress widget view.",
                  "parameters": {
                    "viewMode": {
                      "title": "View",
                      "type": "enum",
                      "default": "classProgress",
                      "values": [
                        { "name": "Class", "value": "classProgress" }
                      ]
                    }
                  }
                },
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ],
      "./plugins/with-android-localized-string-defaults"
    ],
    "locales": {
      "ar-SA": "./locales/ios/ar-SA.json",
      "de-DE": "./locales/ios/de-DE.json",
      "en-AU": "./locales/ios/en-AU.json",
      "en-CA": "./locales/ios/en-CA.json",
      "en-GB": "./locales/ios/en-GB.json",
      "en-US": "./locales/ios/en-US.json",
      "es-ES": "./locales/ios/es-ES.json",
      "es-MX": "./locales/ios/es-MX.json",
      "fr-CA": "./locales/ios/fr-CA.json",
      "fr-FR": "./locales/ios/fr-FR.json",
      "hi": "./locales/ios/hi.json",
      "ja": "./locales/ios/ja.json",
      "ko": "./locales/ios/ko.json",
      "pt-BR": "./locales/ios/pt-BR.json",
      "pt-PT": "./locales/ios/pt-PT.json",
      "zh-Hans": "./locales/ios/zh-Hans.json",
      "zh-Hant": "./locales/ios/zh-Hant.json"
    },
    "extra": {
      "eas": {
        "projectId": "69335c75-753e-424e-8a76-c8bd2455a112"
      }
    },
    "owner": "xxmnewman9xx"
  }
}
