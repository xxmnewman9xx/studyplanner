{
  "expo": {
    "name": "StudyPlanner: Syllabus AI",
    "slug": "study-planner-syllabus-ai",
    "version": "1.0.2",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/app/study-planner-icon.png",
    "scheme": "studyplanner",
    "splash": {
      "image": "./assets/app/study-planner-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mattnewman.studyplanner",
      "icon": "./assets/app/study-planner-icon.png",
      "buildNumber": "33",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.mattnewman.studyplanner"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Use the camera to read syllabus photos with OCR and turn assignments, exams, and deadlines into reviewed planner items.",
        "NSPhotoLibraryUsageDescription": "Use selected syllabus photos for OCR so assignments, exams, and deadlines can be reviewed before they are added.",
        "NSCalendarsFullAccessUsageDescription": "Sync assignment and exam dates to your calendar.",
        "NSUserNotificationsUsageDescription": "Send calm reminders before deadlines, exams, and classes."
      }
    },
    "android": {
      "package": "com.studyplanner.syllabusai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app/study-planner-icon.png",
        "backgroundColor": "#F7F8FA"
      },
      "permissions": [
        "CAMERA",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-calendar",
      "expo-document-picker",
      "expo-image-picker",
      "expo-notifications",
      "expo-iap",
      "expo-font",
      "./plugins/with-widgetkit-kinds",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.mattnewman.studyplanner.widgets",
          "groupIdentifier": "group.com.mattnewman.studyplanner",
          "widgets": [
            {
              "name": "StudyPlannerTodayWidget",
              "kind": "studyplanner.today",
              "displayName": "StudyPlanner Today",
              "description": "See what needs your attention today.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryInline",
                "accessoryCircular",
                "accessoryRectangular"
              ],
              "contentMarginsDisabled": true
            },
            {
              "name": "StudyPlannerUpcomingWidget",
              "kind": "studyplanner.upcoming",
              "displayName": "StudyPlanner Upcoming",
              "description": "Preview upcoming assignments and deadlines.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryInline",
                "accessoryCircular",
                "accessoryRectangular"
              ],
              "contentMarginsDisabled": true
            },
            {
              "name": "StudyPlannerWeekWidget",
              "kind": "studyplanner.week",
              "displayName": "StudyPlanner Week",
              "description": "Check your weekly workload at a glance.",
              "supportedFamilies": [
                "systemMedium",
                "accessoryInline",
                "accessoryCircular",
                "accessoryRectangular"
              ],
              "contentMarginsDisabled": true
            },
            {
              "name": "StudyPlannerClassProgressWidget",
              "kind": "studyplanner.classProgress",
              "displayName": "StudyPlanner Class Progress",
              "description": "Track progress for a selected class.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryInline",
                "accessoryCircular",
                "accessoryRectangular"
              ],
              "contentMarginsDisabled": true
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "69335c75-753e-424e-8a76-c8bd2455a112",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.mattnewman.studyplanner.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.mattnewman.studyplanner"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "xxmnewman9xx"
  }
}
